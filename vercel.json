{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/",
      "destination": "/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/book-theme-finder",
      "destination": "/api/index?route=book-theme-finder"
    },
    {
      "source": "/api/lesson-plan-copier",
      "destination": "/api/index?route=lesson-plan-copier"
    },
    {
      "source": "/api/planner-save",
      "destination": "/api/index?route=planner-save"
    },
    {
      "source": "/api/planner-load",
      "destination": "/api/index?route=planner-load"
    },
    {
      "source": "/api/planner-template-save",
      "destination": "/api/index?route=planner-template-save"
    },
    {
      "source": "/api/planner-template-load",
      "destination": "/api/index?route=planner-template-load"
    },
    {
      "source": "/api/planner-export-pdf",
      "destination": "/api/index?route=planner-export-pdf"
    },
    {
      "source": "/api/planner-export-saved-pdf",
      "destination": "/api/index?route=planner-export-saved-pdf"
    },
    {
      "source": "/api/attachment",
      "destination": "/api/index?route=attachment"
    }
  ]
}
